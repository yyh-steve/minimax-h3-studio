# 复制为 .env 后填写。本文件只做示例，不要把真实 Key 提交到仓库。

# 独立凭证。mock 不需要 Key；H3 local 只使用 H3_API_KEY。
H3_API_KEY=
M3_API_KEY=

# 兼容旧配置：仅 official 且对应独立 Key 为空时回退到此值。
# 不会把这个共享官网 Key 用于 local H3。
MINIMAX_API_KEY=

# M3 文本/多模态接口的根（OpenAI 兼容，带 /v1）
M3_BASE_URL=https://api.minimax.cn/v1

# H3 视频生成 V2 的根地址（不要带末尾斜杠）。
# 国内 API 参考页使用 https://api.minimax.cn；视频生成指南示例使用 https://api.minimaxi.com，以控制台为准。
H3_BASE_URL=https://api.minimax.cn

# H3：mock / local / official；M3：mock / official。
# 默认双 mock，不调用真实模型。接本地 H3 请参照 .env.local.example。
H3_PROVIDER=mock
M3_PROVIDER=mock

# 运行参数
HOST=127.0.0.1
PORT=8000
MAX_CONCURRENCY=2
POLL_INTERVAL_SECONDS=10
AUTO_RETRY_LIMIT=1
# H3_PROVIDER=local 时失败或质检不通过均不自动新建生成 Take。
BUDGET_OUTPUT_SECONDS=90

# M4：M3 看片质检
# true=技术检查通过后再让 M3 看一遍画面（花 M3 token）；false=只做技术检查
M3_TAKE_REVIEW=true
# 官网 video_url.fps，0.2-5，默认 1；看片用 2 帧/秒足够发现大多数问题
M3_REVIEW_FPS=2
# low 最省 token，default/high 更细
M3_REVIEW_DETAIL=low
# 假 M3 看片场景（M3_PROVIDER=mock 时生效）：pass/fail_once/fail/uncertain/error_once
M3_MOCK_REVIEW=pass
