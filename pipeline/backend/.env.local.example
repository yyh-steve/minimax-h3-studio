# 本地 H3 模板。复制为 .env 后按需填写，不要提交真实 Key。
# 需先按 ../../docs/deployment.md 部署 H3 API；此模板不会启动或下载模型。
H3_PROVIDER=local
M3_PROVIDER=mock
H3_BASE_URL=http://127.0.0.1:30010
M3_BASE_URL=https://api.minimax.cn/v1

# 必须填写与本地服务一致的专用 Key：至少 24 位、无空白的 ASCII 字符。
# M3_PROVIDER=mock 不需要 M3_API_KEY；改为 official 时单独填写。
H3_API_KEY=
M3_API_KEY=
# 旧共享 Key 仅供 official 兼容回退，local H3 不读取它。
MINIMAX_API_KEY=

# 使用独立 Web 端口，避免与其他流水线实例冲突。
HOST=127.0.0.1
PORT=8100
MAX_CONCURRENCY=1
POLL_INTERVAL_SECONDS=10
# 本地失败或质检不通过均交人工处理，不自动新建生成 Take。
AUTO_RETRY_LIMIT=0
BUDGET_OUTPUT_SECONDS=90

# 先只做本地技术检查；真实 M3 看片需另配官方凭证并显式开启。
M3_TAKE_REVIEW=false
M3_REVIEW_FPS=2
M3_REVIEW_DETAIL=low
M3_MOCK_REVIEW=pass
